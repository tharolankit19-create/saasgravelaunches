{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 15 * * 0"
    },
    {
      "path": "/api/cron/saasgrave-sync",
      "schedule": "0 6 * * 1"
    }
  ]
}
