# ─── Supabase ───────────────────────────────────────────────
# The SAME project as Saasgrave. One account works across both sites, and
# `profiles` is shared. Only the `launch_*` tables belong to this app.
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_publishable_key
# Server-only. NEVER expose to the browser. Rotate if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# ─── App ────────────────────────────────────────────────────
# Local dev: http://localhost:3000 · Production: the launches subdomain.
NEXT_PUBLIC_SITE_URL=https://ls.saasgrave.org
# Used for the "part of Saasgrave" links in the footer.
NEXT_PUBLIC_SAASGRAVE_URL=https://saasgrave.org
# Your X/Twitter handle (no @) — the custom directory plan opens a DM to this.
NEXT_PUBLIC_X_HANDLE=saasgrave

# ─── Support gate ───────────────────────────────────────────
# The "upvote 3 makers before you launch" anti-spam rule. OFF by default — on a
# small board there aren't three makers to support yet, so leave this unset (or
# not "true") to let anyone launch immediately. Set it to true later, once the
# board has depth; even then it only kicks in past SUPPORT_GATE_MIN_PRODUCTS
# live products (60).
SUPPORT_GATE_ENABLED=

# ─── Badge gate ─────────────────────────────────────────────
# Require free makers to add the "Featured on Saasgrave Launches" badge to their
# site and verify it before their launch goes live (this is the backlink loop
# that sends traffic both ways). ON by default. Premium makers always skip it.
# Set to "false" to turn the whole requirement off (launches publish instantly).
# Needs the badge_verified columns from supabase/schema.sql.
BADGE_REQUIRED=

# ─── Landing A/B ────────────────────────────────────────────
# What % of first-time landing visitors get sent straight to the leaderboard
# (a one-time redirect — they're never bounced again) so you can test whether a
# proof-first entry converts better. Default 35. Set 0 to disable the test.
AB_LEADERBOARD_PERCENT=35

# ─── Week numbering ────────────────────────────────────────
# The ISO week that counts as "Week 1" on this platform. Displayed week
# numbers are counted from here, so nobody arriving at a new board reads
# "Week 33". SET THIS ONCE, before launch, and never change it — moving it
# renumbers every past week and every archived URL.
# Launch is Monday 2026-08-17, which is ISO week 34 — so Week 1 = W34.
NEXT_PUBLIC_LAUNCH_EPOCH_WEEK=2026-W34

# ─── Scraping (autofill, stage 1) ───────────────────────────
# Firecrawl renders the page (JS included) and returns clean markdown — much
# better input for autofill than the built-in fetch scraper, especially for
# SPA landing pages. Optional: without it, autofill falls back to the built-in
# scraper automatically. https://firecrawl.dev
FIRECRAWL_API_KEY=

# ─── AI (autofill stage 2 + traffic diagnosis) ──────────────
# OpenRouter. https://openrouter.ai/keys
#
# IMPORTANT: Firecrawl above only READS the page. This key is what actually
# WRITES the listing — the real tagline, description, who-it's-for, problem,
# solution, edge, FAQ and keyword phrases. Without it, autofill can only fill
# name/tagline/keywords from the page's own meta text (which reads generic).
# For the full "paste a URL, everything fills, top-level SEO" experience, this
# MUST be set.
OPENROUTER_API_KEY=
# STRONGLY RECOMMENDED: pin a capable model here — it's tried first, ahead of
# the built-in free ladder (whose free models are often rate-limited or retired,
# which is the usual reason autofill "doesn't fill"). Good picks:
#   openai/gpt-4o-mini          (cheap, reliable, great quality)
#   anthropic/claude-3.5-haiku  (cheap, excellent copy)
#   google/gemini-2.0-flash-001 (cheap, fast)
# Or any current free model from https://openrouter.ai/models?q=free
OPENROUTER_MODEL=

# ─── Dodo Payments ──────────────────────────────────────────
# https://app.dodopayments.com → Developer → API Keys
DODO_API_KEY=your_dodo_secret_key
# Required — the webhook refuses to fulfil anything without it.
DODO_WEBHOOK_SECRET=your_dodo_webhook_signing_secret
# test_mode | live_mode  (must match the key above)
DODO_ENV=test_mode

# One fixed-price Dodo product per price point. There is deliberately no
# shared fallback: a fallback is how a $9 slot ends up charging $29.
DODO_PRODUCT_ID_FEATURED_9=prod_aaaaaaaa    # Featured        — $9  / launch week
DODO_PRODUCT_ID_SIDEBAR_19=prod_bbbbbbbb    # Sidebar Slot    — $19 / month
DODO_PRODUCT_ID_FEED_PRIME=prod_eeeeeeee    # Prime Slot      — $29 / month (in-board banner)
DODO_PRODUCT_ID_PREMIUM_29=prod_cccccccc    # Premium         — $29 / month (SUBSCRIPTION)
DODO_PRODUCT_ID_DIRECTORY_49=prod_dddddddd  # Directory Starter List — $49  one-off (30 dirs)
DODO_PRODUCT_ID_DIRECTORY_99=prod_ffffffff  # Directory Growth List  — $99  one-off (70 dirs)
DODO_PRODUCT_ID_DIRECTORY_149=prod_gggggggg # Directory Premium List — $149 one-off (100+ dirs)

# ─── No-login directory-blast order links ───────────────────
# The /directories/order flow needs no account — buyers pay through a HOSTED
# Dodo payment link (a public checkout URL, not a secret). The $99/70+ link is
# hard-coded as the default in src/lib/directory-orders.ts. Set these only to
# override per tier, e.g. once the $49 and $149 tiers get their own links.
DODO_DIRECTORY_LINK_49=   # e.g. https://checkout.dodopayments.com/buy/pdt_xxx?quantity=1
DODO_DIRECTORY_LINK_99=   # overrides the built-in $99/70+ link if set
DODO_DIRECTORY_LINK_149=  # e.g. https://checkout.dodopayments.com/buy/pdt_yyy?quantity=1

# ─── Planets (conquer the solar system, pay-to-own) ─────────
# The custom-amount product — a $1/unit "pay-what-you-want" product, quantity
# carries the dollars. Default link + $1/unit live in src/lib/planets.ts.
PLANET_DODO_LINK=     # default: https://checkout.dodopayments.com/buy/pdt_0NloRH53R9K6gpPSvvea4
PLANET_UNIT_DOLLARS=  # dollars per Dodo quantity unit (default 1)

# Premium is a recurring subscription in Dodo, not a one-off product. Create it
# as a subscription so renewal webhooks push `current_period_end` forward; if a
# renewal never arrives the subscription lapses on its own rather than running
# free forever.

# ─── Email (Resend) ─────────────────────────────────────────
# Powers the "your product is live" email and the Sunday digest. Without it,
# both are silent no-ops — nothing breaks, no mail is sent. https://resend.com
RESEND_API_KEY=
# The verified sender. Must be on a domain you've verified in Resend.
EMAIL_FROM=Saasgrave Launches <launches@saasgrave.org>

# ─── Weekly digest cron ─────────────────────────────────────
# The Sunday digest route (/api/cron/weekly-digest) is protected by this. On
# Vercel, set CRON_SECRET and the platform attaches it to the scheduled call
# automatically (see the crons block in vercel.json). To run it by hand you can
# instead use the ADMIN_INSIGHTS_TOKEN below as a bearer.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=

# ─── Admin / Hermes watcher ─────────────────────────────────
# Bearer token for GET /api/admin/insights, so the Hermes agent can poll the
# traffic diagnosis unattended. Leave blank and machine access stays OFF —
# a signed-in admin can still read /admin in the browser.
# Generate one with:  openssl rand -hex 32
ADMIN_INSIGHTS_TOKEN=
